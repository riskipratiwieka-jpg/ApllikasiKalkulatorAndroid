<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SENSOR HP"
            android:textAlignment="center"
            android:textColor="#1565C0"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gyroscope dan Accelerometer"
            android:textAlignment="center"
            android:textColor="#555555"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sensor siap digunakan"
            android:textColor="#2E7D32"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvAccelerometer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accelerometer menunggu data..."
            android:textColor="#212121"
            android:textSize="18sp"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:elevation="3dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvGyroscope"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gyroscope menunggu data..."
            android:textColor="#212121"
            android:textSize="18sp"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:elevation="3dp"
            android:layout_marginBottom="28dp" />

        <Button
            android:id="@+id/btnKembali"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kembali"
            android:textSize="16sp"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>
